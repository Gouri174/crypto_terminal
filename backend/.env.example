ANTHROPIC_API_KEY=sk-ant-...
UNIVERSE_SIZE=40
LLM_CANDIDATES=6

# Background scanner
SCANNER_ENABLED=true
SCAN_INTERVAL_SECONDS=300
LLM_SCORE_CHANGE_THRESHOLD=8
LLM_MAX_AGE_SECONDS=1800

# Optional: swap SQLite for Postgres (e.g. Render's free Postgres) so
# backfilled history survives redeploys.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
